{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palisade",
  "version": "0.1.0",
  "identifier": "org.palisade.gui",
  "build": {
    "beforeDevCommand": "cd ../src && pnpm dev",
    "beforeBuildCommand": "cd ../src && pnpm build",
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Palisade",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon_512.png"
    ]
  }
}
